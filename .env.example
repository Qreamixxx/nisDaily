# Copy this file to ".env" and edit. ".env" is ignored by git, so passwords never reach GitHub.

# --- Database (defaults match a fresh XAMPP) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nisdaily
DB_USER=root
DB_PASS=

# --- App ---
# true shows PHP errors on screen. Keep it false on any public server.
APP_DEBUG=false
APP_TZ=Asia/Almaty

# --- Booking rules ---
# A student cannot book a lesson that starts in less than this many hours.
BOOKING_CUTOFF_HOURS=2
# Max active bookings per student, per subject, per week.
BOOKING_MAX_PER_SUBJECT_WEEK=3
